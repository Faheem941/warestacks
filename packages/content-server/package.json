{
  "private": true,
  "name": "@warestacks/content-server",
  "version": "0.1.0",
  "main": "src/main.js",
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.9.0"
  },
  "scripts": {
    "start": "pm2 start build/main.js --no-daemon -i max --kill-timeout 9000",
    "gcp-build": "yarn build",
    "build": "tsc -b",
    "dev:tsc": "tsc -b -w --preserveWatchOutput",
    "dev": "nodemon --watch \"src/**\" --watch \"../common/**\" --ext \"ts,json\" --exec \"ts-node --files --transpiler sucrase/ts-node-plugin src/main.ts\"",
    "dev:inspect": "nodemon --watch \"src/**\" --watch \"../common/**\" --ext \"ts,json\" --exec \"cross-env TS_NODE_FILES=true node --inspect-brk -r ts-node/register src/main.ts\"",
    "dangerous:prodrun": "tsc -b && node --inspect build/main.js --prodtest",
    "lint:check": "eslint src --ext=.js,.jsx,.ts,.tsx",
    "lint": "yarn lint:check --fix",
    "inspect": "yarn cross-env TS_NODE_FILES=true node --inspect-brk -r ts-node/register src/main.ts",
    "scripts": "yarn cross-env TS_NODE_FILES=true node --inspect -r ts-node/register scripts/index.ts"
  },
  "dependencies": {
    "@warestacks/common": "^1.0.0",
    "@google-cloud/connect-datastore": "^6.0.1",
    "@google-cloud/datastore": "^7.2.0",
    "@google-cloud/profiler": "^5.0.4",
    "@google-cloud/secret-manager": "^4.2.0",
    "apollo-server-express": "^3.13.0",
    "apollo-server-types": "^3.7.1",
    "async": "^3.2.4",
    "bcrypt": "^5.1.0",
    "bluebird": "^3.7.2",
    "chalk": "^4.1.2",
    "cli-highlight": "^2.1.11",
    "compression": "^1.7.4",
    "connect-mongo": "^5.0.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "csurf": "^1.11.0",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "express-session": "^1.17.3",
    "googleapis": "^111.0.0",
    "graphql": "^16.6.0",
    "graphql-advanced-projection": "^2.0.0",
    "graphql-compose": "^9.0.10",
    "graphql-compose-mongoose": "^9.7.2",
    "graphql-depth-limit": "^1.1.0",
    "graphql-parse-resolve-info": "^4.13.0",
    "graphql-upload": "^15.0.2",
    "helmet": "^6.0.1",
    "mongodb": "^5.7.0",
    "mongoose": "^7.4.0",
    "mongoose-unique-validator": "^4.0.0",
    "morgan": "^1.10.0",
    "pm2": "^5.3.1",
    "validator": "^13.9.0"
  },
  "devDependencies": {
    "@types/async": "^3.2.16",
    "@types/bcrypt": "^5.0.0",
    "@types/bluebird": "^3.5.38",
    "@types/body-parser": "^1.19.2",
    "@types/compression": "^1.7.2",
    "@types/cookie-parser": "^1.4.3",
    "@types/cors": "^2.8.13",
    "@types/csurf": "^1.11.2",
    "@types/express": "^4.17.17",
    "@types/express-session": "^1.17.5",
    "@types/graphql-depth-limit": "^1.1.3",
    "@types/graphql-upload": "^15.0.2",
    "@types/mongoose-unique-validator": "^1.0.6",
    "@types/morgan": "^1.9.4",
    "@types/node": "^16.18.12",
    "@types/node-cron": "^3.0.7",
    "@types/node-fetch": "^2.6.2",
    "@types/seed-random": "^2.2.1",
    "@types/sharp": "^0.31.1",
    "@types/validator": "^13.7.12",
    "@types/web-push": "^3.3.2",
    "@types/ws": "^8.5.4",
    "concurrently": "^7.6.0",
    "cross-env": "^7.0.3",
    "mongodb-memory-server": "^8.11.4",
    "sucrase": "^3.35.0",
    "ts-node": "^10.9.2",
    "typescript": "^4.9.5"
  }
}
